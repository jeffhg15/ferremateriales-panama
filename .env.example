# Copie este archivo a .env y ajuste los valores. No guarde secretos en el repositorio.
PORT=5173
# Carpeta para la base SQLite, imágenes subidas y credenciales de demostración generadas.
DATA_DIR=data
# true: carga datos de demostración, muestra el aviso "Demostración" y permite restablecer datos.
DEMO_MODE=true
# true cuando se sirve por HTTPS (cookie de sesión Secure).
SECURE_COOKIES=false
# Opcional: contraseñas para las cuentas sembradas. Si se omiten, se generan al azar
# y se escriben en DATA_DIR/demo-credentials.txt.
SEED_ADMIN_PASSWORD=
SEED_INVENTORY_PASSWORD=
SEED_ORDERS_PASSWORD=
SEED_CUSTOMER_PASSWORD=
